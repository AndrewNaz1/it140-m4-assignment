# IT 140 Module Four Assignment
# Higher/Lower Game PseudoCode 
# Welcome the player and explain the game.    DISPLAY "Welcome to the higher/lower game, Bella!"

# --- Establish a valid guessing range ---    
# Prompt for the lower and upper bounds, and keep re-prompting    
# until the lower bound is strictly less than the upper bound.    
DO        
    PROMPT "Enter the lower bound: " and GET lowerBound         
    PROMPT "Enter the upper bound: " and GET upperBound

    IF lowerBound >= upperBound THEN            
        DISPLAY "The lower bound must be less than the upper bound."      
    END IF    
WHILE lowerBound >= upperBound

# --- Pick the number the player is trying to guess ---    
SET randomNumber = GENERATE_RANDOM_INTEGER(lowerBound, upperBound)
  
# --- Play the game ---    
# Keep asking for guesses until the player finds the number.    
# It is the FIRST guess, so prompt with the full "Great, now..." line.    
PROMPT "Great, now guess a number between " + lowerBound + " and " + upperBound + ": "    
GET guess

# Input validation: the guess must be a whole number inside the range.    WHILE guess < lowerBound OR guess > upperBound        
    DISPLAY "Your guess must be between " + lowerBound + " and " + upperBound + "."        
    PROMPT "Guess another number: "        
    GET guess    
END WHILE

# Compare the guess and give feedback; loop until the guess is correct.    
WHILE guess != randomNumber        
    IF guess < randomNumber THEN            
        DISPLAY "Nope, too low."        
    ELSE            
        DISPLAY "Nope, too high."        
    END IF

    # Ask again and validate the new guess before comparing it.          
    PROMPT "Guess another number: "        
    GET guess
       
    WHILE guess < lowerBound OR guess > upperBound            
        DISPLAY "Your guess must be between " + lowerBound + " and " + upperBound + "."            
        PROMPT "Guess another number: "            
        GET guess        
    END WHILE    
END WHILE

# The only way out of the loop is a correct guess.    
DISPLAY "You got it!"


